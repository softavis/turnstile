{
    "name": "softavis/turnstile",
    "description": "Framework-independent server-side Cloudflare Turnstile verification for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-filter": "*",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.80",
        "guzzlehttp/psr7": "^2.7",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Softavis\\Turnstile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softavis\\Turnstile\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "style": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    }
}
